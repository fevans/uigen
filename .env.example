# Copy this file to .env and fill in real values.

# Anthropic API key for component generation. Get one at:
# https://console.anthropic.com/settings/keys
# Leave as the placeholder to run with the canned mock provider instead.
ANTHROPIC_API_KEY="your-api-key-here"

# Secret used to sign auth session JWTs. Set a long random string in production.
JWT_SECRET="change-me-in-production"
